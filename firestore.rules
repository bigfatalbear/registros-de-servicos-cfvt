rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuários autenticados só leem/escrevem seus próprios dados
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /clientes/{clienteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.tecnicoId;
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
    }

    match /orcamentos/{orcamentoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.tecnicoId;
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
    }

    match /ordensServico/{osId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.tecnicoId;
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
    }

    match /pecas/{pecaId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.tecnicoId;
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
    }

    match /pagamentos/{pagamentoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.tecnicoId;
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
    }
  }
}
